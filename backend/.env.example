NODE_ENV=development
PORT=5050
API_HOST=127.0.0.1
MONGO_URI=mongodb://127.0.0.1:27017/edufinance_live?replicaSet=rs0
JWT_SECRET=GENERATE_JWT_SECRET
SETUP_TOKEN=GENERATE_SETUP_TOKEN
INSTITUTION_NAME=EduFinance
APP_TIMEZONE=Asia/Kolkata
